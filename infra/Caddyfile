# Edge proxy. SONORA_API_ADDRESS decides how the API is served:
#   api.example.com   → automatic HTTPS (Let's Encrypt; port 80 or 443 must reach Caddy)
#   :80               → plain HTTP on the server IP (no domain yet)
{
	email {$ACME_EMAIL}
}

{$SONORA_API_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Object storage (S3 path-style). Uploads and private media need a signature; the signature
	# covers the Host header, which Caddy forwards unchanged. No body limit: sources reach 2 GB.
	@storage path /sonora-uploads/* /sonora-media/* /sonora-public/*
	handle @storage {
		reverse_proxy {$SONORA_S3_UPSTREAM:s3:8333}
	}

	@api path /v1/* /healthz /readyz
	handle @api {
		request_body {
			max_size 10MB
		}
		reverse_proxy {$SONORA_API_UPSTREAM:api:8000} {
			header_up X-Request-ID {http.request.uuid}
			health_uri /healthz
			health_interval 5s
			health_timeout 2s
			lb_try_duration 5s
		}
	}

	# Everything else is the web app (pages, /api/session/*, static assets).
	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy {$SONORA_WEB_UPSTREAM:web:3000}
	}

	log {
		output stdout
		format json
	}
}
