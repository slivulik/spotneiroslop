{
  "name": "@sonora/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sonora design tokens: single JSON source → CSS variables, Tailwind v4 theme, typed JS and Kotlin.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./tokens.json"
  },
  "files": ["dist", "tokens.json"],
  "scripts": {
    "build": "node src/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
