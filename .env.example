# Copy to .env and adjust. Never commit .env.

# --- API ---------------------------------------------------------------------
SONORA_ENV=dev
SONORA_LOG_LEVEL=INFO
SONORA_LOG_JSON=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SONORA_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SONORA_DATABASE_URL=postgresql+asyncpg://sonora:sonora@localhost:5432/sonora
SONORA_REDIS_URL=redis://localhost:6379/0
SONORA_WEB_BASE_URL=http://localhost:3000
# Public artwork bucket URL (anonymous read).
SONORA_MEDIA_BASE_URL=http://localhost:9000/sonora-public
SONORA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated OAuth client ids (web + Android) accepted for Google sign-in.
SONORA_GOOGLE_CLIENT_IDS=
# Object storage (SeaweedFS locally; R2 / B2 / Hetzner in production) and the job queue.
SONORA_S3_ENDPOINT_URL=http://localhost:9000
SONORA_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
SONORA_S3_ACCESS_KEY=sonora
SONORA_S3_SECRET_KEY=sonora-secret
SONORA_QUEUE_URL=redis://localhost:6379/1
SONORA_WORKER_PROCESSES=2
# console | smtp
SONORA_EMAIL_BACKEND=console
SONORA_EMAIL_FROM=Sonora <no-reply@sonora.local>
SONORA_SMTP_HOST=
SONORA_SMTP_PORT=587
SONORA_SMTP_USERNAME=
SONORA_SMTP_PASSWORD=
# Open sources in admin → «Открытые источники» (Creative Commons / public domain only).
# Set to false to hide search and import from Jamendo and Internet Archive entirely.
SONORA_SOURCES_ENABLED=true
# Jamendo needs a free API key: sign up at https://devportal.jamendo.com, create an application
# and paste its Client ID here (then restart the API). Empty = Jamendo is disabled.
SONORA_JAMENDO_CLIENT_ID=
# Media worker: size cap (bytes) and time limit (seconds) for downloading an imported track.
SONORA_IMPORT_MAX_BYTES=524288000
SONORA_IMPORT_TIMEOUT_SECONDS=1800

# --- Infrastructure (docker compose) -------------------------------------------
POSTGRES_USER=sonora
POSTGRES_PASSWORD=sonora
POSTGRES_DB=sonora
S3_ACCESS_KEY=sonora
S3_SECRET_KEY=sonora-secret
CLICKHOUSE_USER=sonora
CLICKHOUSE_PASSWORD=sonora
MEILI_MASTER_KEY=sonora-dev-master-key-change-me

# --- Production edge (Caddy) ---------------------------------------------------
SONORA_DOMAIN=example.com
ACME_EMAIL=admin@example.com
